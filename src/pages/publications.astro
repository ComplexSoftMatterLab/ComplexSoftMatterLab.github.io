---
import Layout from "../layouts/Layout.astro";
import { publications } from "../data/publications";

const years = [...new Set(publications.map((publication) => publication.year))]
  .sort((a, b) => b - a);

const typeLabels = {
  journal: "Journal Articles",
  review: "Review Articles",
};

const types = ["journal", "review"] as const;
---

<Layout title="研究業績 | 複雑ソフトマター研究室">

  <section class="page-header">
    <p class="section-label">Publications</p>
    <h1>研究業績</h1>
  </section>


  <section class="publication-section">

    {years.map((year) => (
      <div class="publication-year">

        <h2>{year}</h2>

        {types.map((type) => {
          const items = publications.filter(
            (publication) =>
              publication.year === year &&
              publication.type === type
          );

          if (items.length === 0) {
            return null;
          }

          return (
            <div class="publication-category">

              <h3>{typeLabels[type]}</h3>

              <ol class="publication-list">

                {items.map((publication) => (
                  <li>

                    <p class="authors">
                      {publication.authors.map((author, index) => (
                        <>
                          {author === "Kang Kim"
                            ? <strong>{author}</strong>
                            : author}
                          {index < publication.authors.length - 1 ? ", " : ""}
                        </>
                      ))}
                    </p>

                    <p class="paper-title">
                      {publication.title}
                    </p>

                    <p class="journal">
                      <em>{publication.journal}</em>
                      {" "}
                      <strong>{publication.volume}</strong>,
                      {" "}
                      {publication.pages}
                      {" "}
                      ({publication.year}).
                    </p>

                    <p class="publication-links">
                      <a
                        href={`https://doi.org/${publication.doi}`}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        DOI
                      </a>
                   </p>

                  </li>
                ))}

              </ol>

            </div>
          );
        })}

      </div>
    ))}

  </section>

</Layout>
