---
import Layout from "../layouts/Layout.astro";
import { news } from "../data/news";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const latestNews = news[0];

const formatDate = (date: string) => date.replaceAll("-", ".");
---

<Layout title="複雑ソフトマター研究室 | Complex Soft Matter Laboratory">

  <!-- Hero -->
  <section class="hero">

    <p class="hero-lab">
      Complex Soft Matter Laboratory
    </p>

    <h1>
      複雑ソフトマターの化学工学を創る
    </h1>

    <p class="hero-tagline">
      Bridging the Scales
    </p>

    <p class="hero-affiliation">
      大阪大学大学院基礎工学研究科<br />
      Graduate School of Engineering Science, The University of Osaka
    </p>

  </section>


  <!-- Introduction -->
  <section class="home-intro">

    <p class="section-label">About Us</p>
    <h2>複雑ソフトマターを、スケールを越えて理解する</h2>

    <p>
      複雑ソフトマター研究室では、分子間相互作用から分子集合体、
      階層構造、さらに巨視的な構造・物性・流動・機能へ至る
      マルチスケール現象の理解を目指しています。
    </p>

    <p>
      移動現象論、統計力学、物理化学、分子シミュレーション、連続体モデリング、
      データ駆動科学を融合し、分子からマクロまでの時間・空間スケールを
      橋渡しすることで、複雑ソフトマターを統一的に理解する
      新たな化学工学の学理構築に取り組みます。
    </p>

  </section>


<!-- Research -->
<section class="home-section">

  <p class="section-label">Research</p>
  <h2>研究</h2>

  <div class="home-research-grid">

    <article class="card">
      <p class="pillar-number">Pillar 1</p>
      <h3>複雑ソフトマターの分子機構</h3>
      <p class="card-title-en">
        Molecular Mechanism
      </p>

      <div class="research-image">
        <img
          src="/images/research/water.png"
          alt="水素結合ネットワーク"
        />
      </div>
    </article>


    <article class="card">
      <p class="pillar-number">Pillar 2</p>
      <h3>マルチスケール構造–流動関係</h3>
      <p class="card-title-en">
        Multiscale Structure–Flow Relationships
      </p>

      <div class="research-image">
        <img
          src="/images/research/polymer.png"
          alt="多数の高分子鎖からなる複雑な分子集合体"
        />
      </div>
    </article>


    <article class="card">
      <p class="pillar-number">Pillar 3</p>
      <h3>データ駆動による原理の理解</h3>
      <p class="card-title-en">
        Data-driven Discovery of Principles
      </p>

      <div class="research-image">
        <img
          src="/images/research/graph.png"
          alt="粒子構造をグラフとして表現したデータ駆動解析"
        />
      </div>
    </article>

  </div>

  <p class="home-link">
    <a href={`${base}/research/`}>研究内容を見る →</a>
  </p>

</section>



  <!-- News -->

  <section class="home-section">

    <p class="section-label">News</p>

    <h2>ニュース</h2>

    {latestNews && (
      <div class="home-news">

        <article class="home-news-item">

          <div class="news-meta">

            <time datetime={latestNews.date}>
              {formatDate(latestNews.date)}
            </time>

            <span class="news-category">
              {latestNews.category}
            </span>

          </div>

          <h3>
            {latestNews.title}
          </h3>

          {latestNews.body && (
            <p>
              {latestNews.body}
            </p>
          )}

        </article>

      </div>
    )}

    <p class="home-link">
      <a href={`${base}/news/`}>ニュース一覧 →</a>
    </p>

  </section>


  <!-- Join -->
  <section class="home-join">

    <p class="section-label">Join Us</p>

    <h2>ともに未知の現象に挑む</h2>

    <p>
      自ら問いを立て、深く考え、挑戦し、
      研究成果を世界へ発信したい学生、社会人博士、博士研究員を歓迎します。
    </p>

    <p class="home-link">
      <a href={`${base}/join/`}>研究室に興味のある方へ →</a>
    </p>

  </section>

</Layout>
