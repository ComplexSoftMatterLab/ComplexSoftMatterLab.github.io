---
import "../styles/style.css";

const {
  title = "複雑ソフトマター研究室 | Complex Soft Matter Laboratory"
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>

    <nav class="navbar">
      <div class="nav-inner">
        <a class="nav-logo" href={`${base}/`}>Complex Soft Matter Lab</a>

        <div class="nav-links">
          <a href={`${base}/`}>ホーム</a>
          <a href={`${base}/research/`}>研究</a>
          <a href={`${base}/people/`}>メンバー</a>
          <a href={`${base}/publications/`}>研究業績</a>
          <a href={`${base}/news/`}>ニュース</a>
          <a href={`${base}/join/`}>研究室に興味のある方へ</a>
          <a href={`${base}/access/`}>アクセス</a>
        </div>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p>
        複雑ソフトマター研究室 / Complex Soft Matter Laboratory
      </p>

      <p>
        大阪大学大学院基礎工学研究科 /
        Graduate School of Engineering Science, The University of Osaka
      </p>
    </footer>

  </body>
</html>
